# 复制到 ~/.config/media-mcp/.env 并 chmod 600。不要提交到 git。
# 图像（OpenAI 兼容 images 接口，gpt-image）
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5
# IMAGE_PROXY=

# reAPI（Suno BGM、Seedance/Wan 兜底、云超分）
REAPI_API_KEY=

# 腾讯云 COS（仅 reAPI 提交本地素材时需要）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
# COS_PATH=/Agent/          # 建议给该前缀配置 30 天生命周期自动删除
# COS_DOMAIN=

# 可选
# MEDIA_PROXY=http://127.0.0.1:7890     # 海外请求代理（也可写在 settings.json 的 proxy）
# MEDIA_WORKDIR=~/Movies/AI-Studio       # 报价单、后台任务等系统状态
# WHISPER_MODEL=~/.local/share/whisper/ggml-large-v3-turbo-q5_0.bin
